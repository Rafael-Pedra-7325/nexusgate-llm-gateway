# Server Configuration
APP_NAME=NexusGate LLM Gateway
ENVIRONMENT=development
PORT=8000
DATABASE_PATH=./gateway_telemetry.db

# Seed realistic demo metrics on startup if database is empty (great for portfolio demos!)
SEED_DEMO_DATA=true

# Sandbox Mode: When true (or when no provider API keys are set), simulates realistic LLM responses,
# latencies, token counts, and costs so anyone can test the gateway without spending credits.
SANDBOX_MODE=true

# Optional Real LLM Provider API Keys (Plug in to route live traffic!)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Semantic Cache Configuration
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.72
CACHE_TTL_SECONDS=3600
